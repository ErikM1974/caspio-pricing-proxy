#!/bin/sh
#
# Pre-commit hook for NWCA API
# Automatically reminds to update Postman when route files change
#

# ANSI color codes for pretty output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Check if any route files are being committed
ROUTE_FILES=$(git diff --cached --name-only | grep "^src/routes/.*\.js$")

# If no route files changed, proceed normally
if [ -z "$ROUTE_FILES" ]; then
  exit 0
fi

# Route files were changed - show what changed
echo ""
echo "${CYAN}🔍 Detected changes in route files:${NC}"
echo "$ROUTE_FILES" | while read -r file; do
  echo "   ${BLUE}→${NC} $file"
done
echo ""

# Warn that Postman should be updated
echo "${YELLOW}⚠️  API routes have changed!${NC}"
echo "${CYAN}📋 Would you like to update Postman collection now?${NC}"
printf "${GREEN}[Y/n]:${NC} "

# Read user input (default to Yes if just Enter is pressed)
read -r response

# Convert to lowercase for comparison
response=$(echo "$response" | tr '[:upper:]' '[:lower:]')

# If user says no (n, no), skip the update
if [ "$response" = "n" ] || [ "$response" = "no" ]; then
  echo "${YELLOW}⏭️  Skipping Postman update${NC}"
  echo "${BLUE}ℹ️  Reminder: Run 'npm run update-postman' later${NC}"
  echo ""
  exit 0
fi

# User said yes (or just pressed Enter) - run the update
echo ""
echo "${CYAN}🚀 Running npm run update-postman...${NC}"
echo ""

# Run the update command
npm run update-postman

# Check if the command succeeded
if [ $? -eq 0 ]; then
  echo ""
  echo "${GREEN}✅ Postman collection updated successfully!${NC}"
  echo "${GREEN}✅ Proceeding with commit...${NC}"
  echo ""
  exit 0
else
  echo ""
  echo "${RED}❌ Postman update failed!${NC}"
  echo "${YELLOW}⚠️  You can still commit with: git commit --no-verify${NC}"
  echo ""

  # Ask if they want to continue anyway
  printf "${CYAN}Continue with commit anyway? [y/N]:${NC} "
  read -r continue_response
  continue_response=$(echo "$continue_response" | tr '[:upper:]' '[:lower:]')

  if [ "$continue_response" = "y" ] || [ "$continue_response" = "yes" ]; then
    echo "${YELLOW}⚠️  Committing without Postman update${NC}"
    echo ""
    exit 0
  else
    echo "${RED}❌ Commit aborted${NC}"
    echo "${BLUE}ℹ️  Fix the issue and try again${NC}"
    echo ""
    exit 1
  fi
fi
